<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="create-user-reviews-table" author="your-name">
        <createTable tableName="user_reviews" remarks="Таблица отзывов пользователей">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="author_user_id" type="bigint">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_user_reviews_author_user_id"
                        references="users(id)"/>
            </column>

            <column name="customer_user_id" type="bigint">
                <constraints
                        nullable="false"
                        foreignKeyName="fk_user_reviews_customer_user_id"
                        references="users(id)"/>
            </column>

            <column name="rating" type="integer" defaultValue="0">
                <constraints nullable="false">
                    <checkConstraint>rating >= 1 AND rating <= 5</checkConstraint>
                </constraints>
            </column>

            <column name="is_moderation" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="text">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="deleted_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
